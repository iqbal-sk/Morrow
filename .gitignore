# Build output
.build/
.swiftpm/
build.noindex/
/Vendor/

# Dev runs (scripts/dev-run.sh): their indexes, models and settings
.dev/

# Python: the reference worker's environment
worker/.venv/
__pycache__/
*.pyc

# Your signing identity for local builds (see build.sh)
.sign-id

# Evals that name your own files
evals/*.local.json

.DS_Store

# The Tauri shell (shell/): Cargo builds and the schemas tauri-build writes
shell/src-tauri/target/
shell/src-tauri/gen/
# What scripts/package-*.sh gather for the packages
shell/src-tauri/helper/
shell/src-tauri/THIRD-PARTY-NOTICES.txt

# Local design notes and UI audit reports are not part of the product repository.
.interface-design/
docs/APP-BEHAVIOR-AUDIT.md
docs/CORAL-UI-REVIEW.md
docs/NATIVE-MACOS-UI.md

# Superseded icon experiments; current exports use the reveal-* layers.
Resources/AppIcon/AppIcon.icon/Assets/morrow-coral.png
Resources/AppIcon/AppIcon.icon/Assets/morrow-mark.svg
